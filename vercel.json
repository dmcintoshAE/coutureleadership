{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/dist/public/index.html" },
    { "source": "/app", "destination": "/dist/public/app.html" },
    { "source": "/app/(.*)", "destination": "/dist/public/app.html" },
    { "source": "/api/coach", "destination": "/api/coach.js" },
    { "source": "/((?!api/).*)", "destination": "/dist/public/$1" }
  ]
}